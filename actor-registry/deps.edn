;; Agent-centric (Holochain-iso) actor registrar for the etzhayyim explorer
;; (ADR-2605231400 / 2606011330 / 2606015600 / 2606112000).
;;
;; Registration is NOT a write to a central list. Each actor is an AGENT (its own
;; ed25519 key = did:key) that authors a SIGNED GENESIS ENTRY on its OWN kotoba
;; Datom source-chain (content-addressed commit-DAG via kotoba.datom), gets a
;; witness MEMBRANE attestation, and self-publishes. The "registry" is an emergent
;; fold (materialized view) over those genesis entries — never a hand-kept constant.
{:paths ["src" "../../../kotoba-lang/kotodama/src"]
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        ;; Transit (transit+json) — the Datomic-client wire standard; used to
        ;; encode a Datom query RESPONSE the browser decodes with transit-cljs.
        com.cognitect/transit-clj {:mvn/version "1.0.333"}}
 :aliases
 {:register {:main-opts ["-m" "etzhayyim.registry.register"]}
  :wire {:main-opts ["-m" "etzhayyim.registry.wire-gen"]}
  ;; live kotoba sync node — XRPC sync.subscribe over SSE (transit+json frames)
  :sync {:main-opts ["-m" "etzhayyim.registry.sync-node"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
